<robot name="my_cubli">

  <material name="white">
    <color rgba="0.9 0.9 0.9 1"/>
  </material>
  <material name="gold">
    <color rgba="0.8 0.6 0.2 1"/>
  </material>

  <!-- body STL: X:-50~50mm, Y:0~100mm, Z:-50~50mm, 中心(0,0.05,0) -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://day4/meshes/body.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://day4/meshes/body.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.05 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0006" ixy="0" ixz="0"
               iyy="0.0006" iyz="0" izz="0.0006"/>
    </inertial>
  </link>

  <!-- flywheel STL: XZ平面の円板, ローカルY軸が回転軸, Y=3~11mm(中心7mm) -->

  <!-- Y軸フライホイール: 底面(Y=0)配置, rpy不要(ローカルY=ワールドY) -->
  <link name="wheel_y">
    <visual>
      <geometry>
        <mesh filename="package://day4/meshes/flywheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gold"/>
    </visual>
    <inertial>
      <origin xyz="0 0.007 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0002" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="joint_y" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_y"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- X軸フライホイール: 右側面(X=+50mm)配置, rpy="0 0 -1.5708"でローカルY=ワールドX -->
  <link name="wheel_x">
    <visual>
      <geometry>
        <mesh filename="package://day4/meshes/flywheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gold"/>
    </visual>
    <inertial>
      <origin xyz="0 0.007 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0002" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="joint_x" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_x"/>
    <origin xyz="0.05 0.05 0" rpy="0 0 1.5708"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Z軸フライホイール: 前面(Z=+50mm)配置, rpy="1.5708 0 0"でローカルY=ワールドZ -->
  <link name="wheel_z">
    <visual>
      <geometry>
        <mesh filename="package://day4/meshes/flywheel.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gold"/>
    </visual>
    <inertial>
      <origin xyz="0 0.007 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0002" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="joint_z" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_z"/>
    <origin xyz="0 0.05 -0.05" rpy="1.5708 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
